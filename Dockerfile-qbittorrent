FROM ubuntu:noble

RUN apt update -y && \
  apt install -y software-properties-common && \
  add-apt-repository ppa:qbittorrent-team/qbittorrent-stable && \
  apt install -y qbittorrent-nox && \
  rm -rf \
    /tmp/* \
    /var/cache/apt/archives/* \
    /var/lib/apt/lists/* \
    /var/tmp/*

RUN mkdir -p /opt/qBittorrent/config && \
    echo '[Preferences]\n\
WebUI\AuthSubnetWhitelist=0.0.0.0/0\n\
WebUI\AuthSubnetWhitelistEnabled=true\n\
WebUI\UseUPnP=false\n' \
>> /opt/qBittorrent/config/qBittorrent.conf

RUN chmod -R 0777 /opt/qBittorrent

USER 1000:1000

ENTRYPOINT [ "qbittorrent-nox" ]
